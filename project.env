PROJECT_SLUG=eia-summary
PROJECT_DISPLAY_NAME="EIA Summary"
PROJECT_VARIANT=weekly_xls
WINDOWS_TASK_NAME="EIA Summary Dashboard"
LAUNCHD_LABEL="com.hoff01.eia-summary"

# Windows release gate defaults.
# Times here are New York/Eastern. The Windows task installer converts the
# Eastern task time to the local clock on the target computer.
RELEASE_TIME_ZONE=America/New_York
WINDOWS_TASK_SCHEDULE_TIME_EASTERN=10:28
RELEASE_MONITOR_START_ET=10:28
RELEASE_POLL_SECONDS=5
RELEASE_MAX_WAIT_MINUTES=2
RELEASE_SCHEDULE_REFRESH_DAYS=7
