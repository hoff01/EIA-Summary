# Optional Outlook account hint for Windows, useful when Outlook has multiple accounts.
# Leave blank to use Outlook's default sending account.
DOE_SUMMARY_OUTLOOK_ACCOUNT=

# Optional SMTP fallback. Windows does not need this when Outlook is available.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DOE_SUMMARY_EMAIL_FROM=
